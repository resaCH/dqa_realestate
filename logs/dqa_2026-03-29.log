            CREATE OR REPLACE VIEW
                workspace.dqa_realestate.gold_gwr_history
            AS
            
        -- Alle historischen Versionen eines Gebäudes
        SELECT
            egid,
            egrid,
            gdekt,
            ggdenr,
            ggdename,
            strname,
            deinr,
            plz4,
            plzname,
            gstat,
            gkat,
            gklas,
            gbauj,
            gabbj,
            garea,
            gvol,
            ganzwhg,
            valid_from,
            valid_to,
            is_current,
            dqa_deleted,
            record_hash,
            DATEDIFF(
                COALESCE(valid_to, CURRENT_TIMESTAMP),
                valid_from
            )                           AS days_valid
        FROM workspace.dqa_realestate.silver_gwr_buildings
        ORDER BY egid, valid_from
    
        
