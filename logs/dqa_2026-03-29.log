                SHA2(COALESCE(CAST(gstat AS STRING), '') || '|' || COALESCE(CAST(gkat AS STRING), '') || '|' || COALESCE(CAST(gklas AS STRING), '') || '|' || COALESCE(CAST(gbauj AS STRING), '') || '|' || COALESCE(CAST(gbaum AS STRING), '') || '|' || COALESCE(CAST(gbaup AS STRING), '') || '|' || COALESCE(CAST(gabbj AS STRING), '') || '|' || COALESCE(CAST(garea AS STRING), '') || '|' || COALESCE(CAST(gvol AS STRING), '') || '|' || COALESCE(CAST(ganzwhg AS STRING), '') || '|' || COALESCE(CAST(gazzi AS STRING), '') || '|' || COALESCE(CAST(gschutzr AS STRING), '') || '|' || COALESCE(CAST(gdekt AS STRING), '') || '|' || COALESCE(CAST(ggdenr AS STRING), '') || '|' || COALESCE(CAST(ggdename AS STRING), '') || '|' || COALESCE(CAST(strname AS STRING), '') || '|' || COALESCE(CAST(deinr AS STRING), '') || '|' || COALESCE(CAST(plz4 AS STRING), '') || '|' || COALESCE(CAST(plzname AS STRING), '') || '|' || COALESCE(CAST(gkode AS STRING), '') || '|' || COALESCE(CAST(gkodn AS STRING), ''), 256) AS record_hash,
                ROW_NUMBER() OVER (
                    PARTITION BY egid
                    ORDER BY _ingested_at DESC
                ) AS rn
            FROM workspace.dqa_realestate.bronze_gwr_buildings
            WHERE egid IS NOT NULL
              
        )
        SELECT * EXCEPT (rn)
        FROM ranked
        WHERE rn = 1
    
