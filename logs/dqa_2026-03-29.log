            COUNT(DISTINCT ggdenr)          AS gemeinden,
            SUM(CASE WHEN gstat = 4 THEN 1 ELSE 0 END) AS bestehende,
            SUM(CASE WHEN gstat = 3 THEN 1 ELSE 0 END) AS im_bau,
            SUM(CASE WHEN gstat = 1 THEN 1 ELSE 0 END) AS geplant,
            MIN(last_mutation_date)                       AS oldest_mutation,
            MAX(last_mutation_date)                       AS latest_mutation
        FROM workspace.dqa_realestate.gold_gwr_current
    
