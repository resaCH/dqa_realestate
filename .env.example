# ============================================================
# DQA Real Estate — Konfiguration
# Kopiere diese Datei zu .env und fülle die Werte aus.
# .env wird NICHT ins Git-Repo eingecheckt (siehe .gitignore).
# ============================================================

# Databricks Free Tier
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net
DATABRICKS_TOKEN=dapi<your-personal-access-token>
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=dqa_realestate

# GWR API (Bundesamt für Statistik)
# Kein API-Key erforderlich für öffentlichen Abruf.
# Dokumentation: https://www.housing-stat.ch/de/madd/public.html
GWR_BASE_URL=https://www.housing-stat.ch/regbl/api/ech0206/v2

# Optionale Einschränkung auf einen Kanton (z.B. AG, ZH, BE …)
# Leer lassen = alle Kantone
GWR_KANTON=

# Watermark-Persistenz (lokaler Pfad oder DBFS-Pfad)
WATERMARK_PATH=./data/watermarks/gwr_watermark.json

# Logging
LOG_LEVEL=INFO
